<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shr.translationtoolservice.dao.ProductRelationMapper">

    <resultMap id="BaseResultMap" type="com.shr.translationtoolservice.entity.ProductRelationEntity">
            <id property="id" column="id" jdbcType="VARCHAR"/>
            <result property="entryId" column="entry_id" jdbcType="VARCHAR"/>
            <result property="versionId" column="version_id" jdbcType="VARCHAR"/>
            <result property="productId" column="product_id" jdbcType="VARCHAR"/>
            <result property="taskId" column="task_id" jdbcType="VARCHAR"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,entry_id,version_id,
        product_id,task_id
    </sql>

    <delete id="deleteByProductIdList">
        delete  from t_product_relation where product_id in(
        <foreach collection="idList" item="id" index="index" separator=",">
            #{id,jdbcType=VARCHAR}
        </foreach>
        );
    </delete>
</mapper>
