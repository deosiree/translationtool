<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shr.translationtoolservice.dao.EntryPropertyMapper">

    <resultMap id="BaseResultMap" type="com.shr.translationtoolservice.entity.EntryProperty">
        <id property="id" column="id" jdbcType="VARCHAR"/>
        <result property="propertyName" column="property_name" jdbcType="VARCHAR"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,property_name
    </sql>

    <select id="getPropertyByName" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from t_entry_property
        <if test="propertyName != null and propertyName != ''">
            where property_name = #{propertyName,jdbcType=VARCHAR}
        </if>

        <if test="limit >= 0 and offset >= 0">
            LIMIT #{limit} OFFSET #{offset}
        </if>
    </select>

    <select id="getPropertyByNameTotal" resultType="int">
        select
        count(1)
        from t_entry_property
         <if test="propertyName != null and propertyName != ''">
        where property_name = #{propertyName,jdbcType=VARCHAR}
    </if>


    </select>

    <update id="updateProperty" parameterType="com.shr.translationtoolservice.entity.EntryProperty">

        update  t_entry_property set property_name =   #{entryProperty.propertyName,jdbcType=VARCHAR} where  id = #{entryProperty.id,jdbcType=VARCHAR}
    </update>

    <insert id="insertProperty" parameterType="com.shr.translationtoolservice.entity.EntryProperty">
          insert into t_entry_property (id,property_name) values (  #{entryProperty.id,jdbcType=VARCHAR},#{entryProperty.propertyName,jdbcType=VARCHAR})
    </insert>

    <delete id="deleteProperty" parameterType="arraylist">
    DELETE FROM t_entry_property WHERE id in (
        <foreach collection="ids" item="id" index="index" separator=",">
            #{id,jdbcType=VARCHAR}
        </foreach>
        );
    </delete>
    <select id="selectProperty" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from t_entry_property
        <where>
            <if test="propertyName != null and propertyName != ''">
                property_name = #{propertyName,jdbcType=VARCHAR}
            </if>
        </where>
    </select>
</mapper>
