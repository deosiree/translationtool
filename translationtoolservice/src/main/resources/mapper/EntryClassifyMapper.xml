<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shr.translationtoolservice.dao.EntryClassifyMapper">

    <resultMap id="BaseResultMap" type="com.shr.translationtoolservice.entity.EntryClassify">
        <id property="key" column="id" jdbcType="VARCHAR"/>
        <result property="parentId" column="parent_id" jdbcType="VARCHAR"/>
        <result property="title" column="name" jdbcType="VARCHAR"/>
        <result property="index" column="index" jdbcType="INTEGER"/>
        <result property="maxByte" column="max_byte" jdbcType="INTEGER"/>
        <result property="department" column="department" jdbcType="VARCHAR"/>
        <result property="creator" column="creator" jdbcType="VARCHAR"/>
        <result property="type" column="type" jdbcType="VARCHAR"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        id ,parent_id,`name`,`type`,
        `index`,max_byte,department,creator, DATE_FORMAT(create_time, '%Y-%m-%d %H:%i:%s') as create_time
    </sql>

    <select id="getEntryClassfyIds" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from t_entry_classify

    </select>

    <select id="getEntryClassfyIdsByDepartment" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from t_entry_classify
        <where>
            <if test="department != null  and department != ''">
                department = #{department,jdbcType=VARCHAR}
            </if>
        </where>
    </select>

    <select id="getEntryClassfyByIds" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from t_entry_classify where id in (
        <foreach collection="classfies" item="classfy" index="index" separator=",">
        #{classfy,jdbcType=VARCHAR}
    </foreach>
    )

    </select>

    <select id="getEntryClassfyByNames" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from t_entry_classify where name in (
        <foreach collection="classfies" item="classfy" index="index" separator=",">
            #{classfy,jdbcType=VARCHAR}
        </foreach>
        )

    </select>



    <select id="getEntryClassfyByParentId" parameterType="arraylist" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from t_entry_classify
        where parent_id in (

        <foreach collection="ids" item="id" index="index" separator=",">
            #{id,jdbcType=VARCHAR}
        </foreach>
        )
    </select>

    <select id="selectByParentId" resultType="com.shr.translationtoolservice.entity.EntryClassify">
        select      id `key`,parent_id,`name` `title`,
        `index`
        from t_entry_classify where id =  #{parentId,jdbcType=VARCHAR}

    </select>
    <select id="selectClassfyById" resultType="com.shr.translationtoolservice.entity.EntryClassify">
        select       id `key`,parent_id,`name` `title`,
        `index`
        from t_entry_classify where id =  #{id,jdbcType=VARCHAR}

    </select>
    <insert id="insertClassfy" parameterType="com.shr.translationtoolservice.entity.EntryClassify">
        INSERT INTO t_entry_classify
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="entryClassify.key != null">
                id,
            </if>
            <if test="entryClassify.parentId != null">
                parent_id,
            </if>
            <if test="entryClassify.title != null">
                `name`,
            </if>
            <if test="entryClassify.index != null">
                `index`,
            </if>
            <if test="entryClassify.maxByte != null">
                `max_byte`,
            </if>
            <if test="entryClassify.department != null">
                `department`,
            </if>
            <if test="entryClassify.creator != null">
                `creator`,
            </if>
            <if test="entryClassify.createTime != null">
                `create_time`,
            </if>
            <if test="entryClassify.type != null">
                `type`,
            </if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="entryClassify.key != null">
                #{entryClassify.key,jdbcType=VARCHAR},
            </if>
            <if test="entryClassify.parentId != null">
                #{entryClassify.parentId,jdbcType=VARCHAR},
            </if>
            <if test="entryClassify.title != null">
                #{entryClassify.title,jdbcType=VARCHAR},
            </if>
            <if test="entryClassify.index != null">
                #{entryClassify.index,jdbcType=VARCHAR},
            </if>
            <if test="entryClassify.maxByte != null">
                #{entryClassify.maxByte,jdbcType=VARCHAR},
            </if>
            <if test="entryClassify.department != null">
                #{entryClassify.department,jdbcType=VARCHAR},
            </if>
            <if test="entryClassify.creator != null">
                #{entryClassify.creator,jdbcType=VARCHAR},
            </if>
            <if test="entryClassify.createTime != null">
                #{entryClassify.createTime,jdbcType=TIMESTAMP},
            </if>
            <if test="entryClassify.type != null">
                #{entryClassify.type,jdbcType=TIMESTAMP},
            </if>
        </trim>
    </insert>

    <delete id="deleteByIds" parameterType="arraylist">
        DELETE FROM t_entry_classify WHERE id in(
        <foreach collection="list" item="id" index="index" separator=",">
            #{id,jdbcType=VARCHAR}
        </foreach>
        );
    </delete>


    <update id="updateClassfyById" parameterType="com.shr.translationtoolservice.entity.EntryClassify">
        update t_entry_classify
        <set>

            <if test="entryClassify.parentId != null  and entryClassify.parentId != ''">
                parent_id = #{entryClassify.parentId ,jdbcType=VARCHAR},
            </if>
            <if test="entryClassify.index != null  and entryClassify.index != ''">
                `index` = #{entryClassify.index,jdbcType=INTEGER},
            </if>
            <if test="entryClassify.title != null  and entryClassify.title != ''">
                `name` = #{entryClassify.title ,jdbcType=VARCHAR},
            </if>
            <if test="entryClassify.maxByte != null  and entryClassify.maxByte != ''">
                `max_byte` = #{entryClassify.maxByte ,jdbcType=VARCHAR},
            </if>

        </set>
        where id = #{entryClassify.key ,jdbcType=VARCHAR}
    </update>
</mapper>
