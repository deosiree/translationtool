# Server
AGENT_HOST=0.0.0.0
# Docker 与本机均用 18002；prepare 会先停 Docker 容器再启本地
AGENT_PORT=18002

# MySQL (existing translationtool database)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=translationtool

# LLM (OpenAI-compatible API — also works with DeepSeek, etc.)
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
