{
  "name": "translation",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "preview": "serve -s dist -l 8080",
    "lint": "vue-cli-service lint --no-fix src prototype",
    "lint:fix": "vue-cli-service lint --no-fix src prototype",
    "lint:all": "vue-cli-service lint --no-fix",
    "check:imports": "node scripts/check-resolved-imports.js",
    "review": "npm run check:imports",
    "review:full": "npm run check:imports && npm run lint:fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "electron:build": "vue-cli-service electron:build",
    "electron:serve": "vue-cli-service electron:serve",
    "postinstall": "electron-builder install-app-deps",
    "postuninstall": "electron-builder install-app-deps"
  },
  "main": "background.js",
  "dependencies": {
    "@ant-design/icons-vue": "^6.1.0",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@tanstack/vue-query": "^5.92.9",
    "@tanstack/vue-table": "^8.21.3",
    "ant-design-vue": "^3.2.20",
    "axios": "^1.4.0",
    "core-js": "^3.8.3",
    "dayjs": "^1.11.18",
    "iconv-lite": "^0.7.2",
    "js-base64": "^3.7.5",
    "keymaster": "^1.6.2",
    "lodash-es": "^4.17.21",
    "moment": "^2.30.1",
    "uuid": "^9.0.1",
    "vue": "^3.2.13",
    "vue-draggable-resizable": "^2.3.0",
    "vue-router": "^4.0.3",
    "vuex": "^4.0.0",
    "vuex-persistedstate": "^4.1.0",
    "xlsx": "^0.18.5",
    "xmlbuilder": "^15.1.1",
    "xmlbuilder2": "^3.1.1"
  },
  "devDependencies": {
    "@babel/core": "^7.12.16",
    "@babel/eslint-parser": "^7.12.16",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitest/coverage-v8": "^4.0.17",
    "@vitest/ui": "^4.0.17",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-eslint": "~5.0.0",
    "@vue/cli-plugin-router": "~5.0.0",
    "@vue/cli-plugin-vuex": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "@vue/test-utils": "^2.4.6",
    "copy-webpack-plugin": "^13.0.0",
    "electron": "^13.0.0",
    "electron-builder": "^24.6.4",
    "electron-devtools-installer": "^3.1.0",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^4.2.5",
    "eslint-plugin-vue": "^8.0.3",
    "jsdom": "^27.4.0",
    "less": "^4.1.3",
    "less-loader": "^7.3.0",
    "prettier": "^3.8.1",
    "ts-loader": "^9.4.3",
    "typescript": "^5.1.3",
    "vitest": "^4.0.17",
    "vue-cli-plugin-electron-builder": "^2.1.1"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true,
      "browser": true,
      "es2021": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended",
      "plugin:import/errors",
      "plugin:import/warnings"
    ],
    "plugins": [
      "import"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser",
      "requireConfigFile": false,
      "ecmaVersion": 2021,
      "sourceType": "module"
    },
    "settings": {
      "import/resolver": {
        "alias": {
          "map": [
            [
              "@",
              "./src"
            ],
            [
              "@prototype",
              "./prototype"
            ]
          ],
          "extensions": [
            ".js",
            ".vue",
            ".json"
          ]
        }
      },
      "import/extensions": [
        ".js",
        ".vue",
        ".json"
      ]
    },
    "rules": {
      "no-unused-vars": [
        "warn",
        {
          "argsIgnorePattern": "^_",
          "varsIgnorePattern": "^_"
        }
      ],
      "no-prototype-builtins": "warn",
      "import/no-unresolved": [
        "error",
        {
          "commonjs": true,
          "caseSensitive": true
        }
      ],
      "import/named": "off",
      "import/namespace": "off",
      "import/default": "off",
      "import/no-named-as-default": "off",
      "import/no-named-as-default-member": "off",
      "import/no-duplicates": "warn",
      "vue/multi-word-component-names": "off",
      "vue/no-unused-components": "warn",
      "vue/no-unused-vars": "warn",
      "vue/require-prop-type-constructor": "warn",
      "vue/require-valid-default-prop": "warn",
      "no-console": "off",
      "no-debugger": "warn"
    },
    "overrides": [
      {
        "files": [
          "src/**/*.{js,vue}",
          "prototype/**/*.{js,vue}"
        ],
        "rules": {
          "import/no-unresolved": "error"
        }
      },
      {
        "files": [
          "tests/**/*.{js,vue}",
          "**/*.test.js",
          "**/*.spec.js"
        ],
        "env": {
          "jest": true
        },
        "rules": {
          "import/no-unresolved": "off",
          "no-unused-vars": "off"
        }
      }
    ]
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ]
}
