        </if>

    </select>


    <delete id="deleteRoleAndUser">
        delete t_user ,t_user_role from t_user join t_user_role on t_user.id = t_user_role.user_id where
        t_user.user_name in
        <trim prefix="(" suffix=")">
            <foreach collection="users" item="user" index="index" separator=",">
                #{user.userName,jdbcType=VARCHAR}
            </foreach>
        </trim>


    </delete>

    <delete id="deleteUser">
        delete from t_user where user_id in
        <trim prefix="(" suffix=")">
            <foreach collection="users" item="user" index="index" separator=",">
                #{user.id,jdbcType=VARCHAR}
            </foreach>
        </trim>
    </delete>


    <insert id="insertUser">
        insert into t_user
        <trim prefix="(" suffix=")" suffixOverrides=",">
            id,
            user_name,
            department,
        </trim>
        values
        <foreach collection="users" item="user" index="index" separator=",">
            (
            <if test="user.id != null and user.id != '' ">#{user.id ,jdbcType=VARCHAR},
            </if>
            <if test="user.userName != null and user.userName != '' ">
                #{user.userName ,jdbcType=VARCHAR},
            </if>
            <if test="user.department != null and user.department != '' ">
                #{user.department ,jdbcType=VARCHAR}
            </if>
            )
        </foreach>
    </insert>

    <insert id="insertRoleAndUser">
        insert into t_user_role
        <trim prefix="(" suffix=")" suffixOverrides=",">
