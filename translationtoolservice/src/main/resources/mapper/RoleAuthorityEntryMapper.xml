<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shr.translationtoolservice.dao.RoleAuthorityEntryMapper">

    <resultMap id="BaseResultMap" type="com.shr.translationtoolservice.entity.RoleAuthorityEntry">
            <id property="id" column="id" jdbcType="VARCHAR"/>
            <result property="roleId" column="role_id" jdbcType="VARCHAR"/>
            <result property="authorityId" column="authority_id" jdbcType="VARCHAR"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,role_id,authority_id
    </sql>

    <insert id="insertPermission" parameterType="java.lang.String">
         insert into t_role_authority (role_id, authority_id)
         values (#{roleId,jdbcType=VARCHAR},#{authId,jdbcType=VARCHAR})
    </insert>

    <select id="selectAuthID" parameterType="java.lang.String" resultType="java.lang.String">
        select id,role_id , authority_id from t_role_authority where role_id =  #{roleId,jdbcType=VARCHAR}
    </select>


    <select id="checkPermiss" parameterType="java.lang.String" resultMap="BaseResultMap">
        select id,role_id , authority_id from t_role_authority where role_id =  #{roleId,jdbcType=VARCHAR} and authority_id=  #{authority_id,jdbcType=VARCHAR}
    </select>
    <delete id="deleteAuthorityByID" parameterType="java.lang.String">
        <!--@mbg.generated-->
        delete from t_role_authority
        where role_id = #{roleId,jdbcType=VARCHAR}
    </delete>

    <update id="updatePermiss"  parameterType="java.lang.String">
        update t_role_authority set role_id = #{roleId,jdbcType=VARCHAR} ,authority_id = #{authority_id,jdbcType=VARCHAR}
    </update>

</mapper>
