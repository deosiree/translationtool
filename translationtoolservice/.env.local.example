# 本机 Java 调试（配合根目录 pnpm dev / pnpm dev:java）

# 首次：copy .env.local.example .env.local

# 端口 18001 与 Docker 互斥（prepare 会先停容器）



SPRING_PROFILES_ACTIVE=docker

SERVER_PORT=18001



SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/translationtool?useUnicode=true&characterEncoding=UTF-8&useJDBCCompliantTimezoneShift=true&useLegacyDatetimeCode=false&serverTimezone=Asia/Shanghai&allowMultiQueries=true&socketTimeout=60000&connectTimeout=5000&autoReconnect=true

SPRING_DATASOURCE_USERNAME=root

SPRING_DATASOURCE_PASSWORD=123456



SPRING_REDIS_HOST=127.0.0.1

SPRING_REDIS_PORT=6379

SPRING_REDIS_PASSWORD=210093

