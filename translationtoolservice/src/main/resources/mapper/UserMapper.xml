        </trim>
        values
        <foreach collection="users" item="user" index="index" separator=",">
            <foreach collection="user.roleId" item="roleId" index="index" separator=",">
                (
                #{user.id ,jdbcType=VARCHAR},
                #{roleId,jdbcType=VARCHAR}
                )
            </foreach>
        </foreach>
    </insert>






