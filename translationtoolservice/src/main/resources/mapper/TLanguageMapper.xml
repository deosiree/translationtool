<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shr.translationtoolservice.dao.TLanguageMapper">

    <resultMap id="BaseResultMap" type="com.shr.translationtoolservice.entity.TLanguage">
        <id property="id" column="id" jdbcType="VARCHAR"/>
        <result property="code" column="code" jdbcType="VARCHAR"/>
        <result property="name" column="name" jdbcType="VARCHAR"/>
        <result property="bdCode" column="bd_code" jdbcType="VARCHAR"/>
        <result property="ydCode" column="yd_code" jdbcType="VARCHAR"/>
        <result property="ggCode" column="gg_code" jdbcType="VARCHAR"/>
        <result property="xfCode" column="xf_code" jdbcType="VARCHAR"/>
        <result property="deeplCode" column="deepl_code" jdbcType="VARCHAR"/>
        <result property="english" column="english" jdbcType="VARCHAR"/>
        <result property="isDelete" column="is_delete" jdbcType="INTEGER"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,code,name,bd_code,yd_code,gg_code,xf_code,deepl_code,english,is_delete
    </sql>

    <select id="getLanguages" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from t_language
        where is_delete =0
        <if test="language.name != null  and language.name != ''">
            and `name` = #{language.name ,jdbcType=VARCHAR}
        </if>
        <if test="language.code != null  and language.code != ''">
            and code = #{language.code ,jdbcType=VARCHAR}
        </if>

    </select>

    <select id="selectLaguageByName" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from t_language
        where is_delete =0
        <if test="language != null  and language != ''">
            and `name` = #{language,jdbcType=VARCHAR}
        </if>

    </select>
    
    <select id="getLanguageByTask" resultMap="BaseResultMap">
      select t1.* from t_language t1 join t_task_info t2 on  t1.`name` = t2.translate_type where t2.id =#{taskID,jdbcType=VARCHAR}
    </select>

</mapper>
