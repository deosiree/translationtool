    <select id="selectRoleColumn">
        select t2.role_name as role_name,t3.id as role_id
        from t_user t1 ,t_role t2 ,t_user_role t3 where t1.id = t3.user_id
        and t2.id = t3.role_id
        <if test="userName != null and userName !='' ">
            and t1.user_name = #{name,jdbcType=VARCHAR}
        </if>
        <if test="department != null and department !='' ">
            and t1.department = #{department,jdbcType=VARCHAR}
        </if>

    </select>


    <select id="selectByName" parameterType="java.lang.String" resultMap="BaseResultMap">
        <!--@mbg.generated-->

        select t1.user_name as user_name , t1.department as department , t1.id as id ,t2.role_name as role_name,t2.id as
        role_id
        from t_user t1 ,t_role t2 ,t_user_role t3 where t1.id = t3.user_id
        and t2.id = t3.role_id
        and t1.user_name = #{name,jdbcType=VARCHAR}

    </select>


    <select id="getUserInfo" resultMap="BaseResultMap">
        select t1.user_name as user_name , t1.id as id , t1.department as department , t2.role_name as role_name,t3.id
        as role_id
        from t_user t1 ,t_role t2 ,t_user_role t3 where t1.id = t3.user_id
        and t2.id = t3.role_id
        <if test="user.userName != null and user.userName  !='' ">
            and t1.user_name = #{user.userName ,jdbcType=VARCHAR}
        </if>
        <if test="user.department != null and user.department !='' ">
            and t1.department = #{user.department,jdbcType=VARCHAR}
        </if>
        <if test="user.roleName  != null  and user.roleName.size != 0 ">
            and t2.role_name in (
            <foreach collection="user.roleName" item="roleName" index="index" separator=",">
                <if test="roleName != null ">
                    #{roleName,jdbcType=VARCHAR}
                </if>
            </foreach>
            )
        </if>
        order by t1.department desc
        <if test="limit >= 0 and offset >= 0">
            LIMIT #{limit} OFFSET #{offset}
        </if>
    </select>


