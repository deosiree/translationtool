<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shr.translationtoolservice.dao.TaskInfoMapper">

    <resultMap id="BaseResultMap" type="com.shr.translationtoolservice.entity.TaskInfoEntity">
        <result property="id" column="id" jdbcType="VARCHAR"/>
        <result property="creator" column="creator" jdbcType="VARCHAR"/>
        <result property="name" column="name" jdbcType="VARCHAR"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
        <result property="endTime" column="end_time" jdbcType="TIMESTAMP"/>
        <result property="department" column="department" jdbcType="VARCHAR"/>
        <result property="developer" column="developer" jdbcType="VARCHAR"/>
        <result property="entryAuditor" column="entry_auditor" jdbcType="VARCHAR"/>
        <result property="translator" column="translator" jdbcType="VARCHAR"/>
        <result property="translationAuditor" column="translation_auditor" jdbcType="VARCHAR"/>
        <result property="description" column=" description" jdbcType="VARCHAR"/>
        <result property="state" column="state" jdbcType="INTEGER"/>
        <result property="versionId" column="version_id" jdbcType="VARCHAR"/>
        <result property="importTime" column="import_time" jdbcType="TIMESTAMP"/>
        <result property="entryAutiorStartTime" column="entry_autior_start_time" jdbcType="TIMESTAMP"/>
        <result property="translationAuditorStartTime" column="translation_auditor_start_time" jdbcType="TIMESTAMP"/>
        <result property="translateStartTime" column="translate_start_time" jdbcType="TIMESTAMP"/>
        <result property="deliveryTime" column="delivery_time" jdbcType="TIMESTAMP"/>
        <result property="translateType" column="translate_type" jdbcType="VARCHAR"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,creator,`name`,
        DATE_FORMAT(create_time, '%Y-%m-%d %H:%i:%s'),
        DATE_FORMAT(end_time, '%Y-%m-%d %H:%i:%s'),department,
        developer,entry_auditor,translator,
        translation_auditor, description,state,
        version_id,
        DATE_FORMAT(import_time, '%Y-%m-%d %H:%i:%s'),
        DATE_FORMAT(entry_autior_start_time, '%Y-%m-%d %H:%i:%s'),
        DATE_FORMAT(translation_auditor_start_time, '%Y-%m-%d %H:%i:%s'),
        DATE_FORMAT(translate_start_time, '%Y-%m-%d %H:%i:%s'),
        DATE_FORMAT(delivery_time, '%Y-%m-%d %H:%i:%s'),translate_type
    </sql>

    <select id="getTaskInfo" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List"/>
        from t_task_info
        where 1=1
        <if test="taskInfoEntity.name != null  and taskInfoEntity.name != ''">
            and `name` = #{taskInfoEntity.name ,jdbcType=VARCHAR}
        </if>
        <if test="taskInfoEntity.department != null  and taskInfoEntity.department != ''">
            and department = #{taskInfoEntity.department ,jdbcType=VARCHAR}
        </if>
        <if test="taskInfoEntity.developer != null  and taskInfoEntity.developer != ''">
            and developer = #{taskInfoEntity.developer ,jdbcType=VARCHAR}
        </if>
        <if test="taskInfoEntity.entryAuditor != null  and taskInfoEntity.entryAuditor != ''">
            and entry_auditor = #{taskInfoEntity.entryAuditor ,jdbcType=VARCHAR}
        </if>
        <if test="taskInfoEntity.translator != null  and taskInfoEntity.translator != ''">
            and translator = #{taskInfoEntity.translator ,jdbcType=VARCHAR}
        </if>
        <if test="taskInfoEntity.translationAuditor != null  and taskInfoEntity.translationAuditor != ''">
            and translation_auditor = #{taskInfoEntity.translationAuditor ,jdbcType=VARCHAR}
        </if>
        <if test="taskInfoEntity.description != null  and taskInfoEntity.description != ''">
            and description = #{taskInfoEntity.description ,jdbcType=VARCHAR}
        </if>
        <if test="taskInfoEntity.state != null  and taskInfoEntity.state != ''">
            and state = #{taskInfoEntity.state ,jdbcType=VARCHAR}
        </if>

        order by create_time desc
        <if test="limit >= 0 and offset >= 0">
            LIMIT #{limit} OFFSET #{offset}
        </if>

    </select>

    <update id="taskSubmission">
        update t_task_info set
    </update>

</mapper>
